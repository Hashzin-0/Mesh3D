# Copy to .env for local Docker Compose use. Keep real secrets out of Git.
# Jobs run in-process through FastAPI BackgroundTasks; there is no Celery/Redis queue.
MESH3D_CORS_ORIGINS=http://localhost:5173
MESH3D_DATA_DIR=/data
MESH3D_MAX_IMAGE_BYTES=26214400
MESH3D_MAX_IMAGES=80
MESH3D_ENGINE_TIMEOUT_SECONDS=7200

# Engines are gated by MESH3D_ENGINE_*_VALIDATION_REPORT (real-run report incl. embedded license_review),
# not by MESH3D_ENGINE_*_LICENSE_APPROVED flags (removed; see docs/ENGINE_VALIDATION_GATE.md).
# Mount your separately cloned, pinned upstream repositories into ./engines (see docs/ENGINE_INTEGRATION.md).
# Each engine needs its own compatible Python environment; set *_PYTHON to that interpreter.
# Do not download checkpoints into Git. Use /data/model-cache for model/cache files.
HF_HOME=/data/model-cache/huggingface
TORCH_HOME=/data/model-cache/torch

# Single-image engine
MESH3D_ENGINE_TRIPOSR_CMD=["python","/opt/mesh3d/wrappers/triposr.py","--input-dir","{input_dir}","--output-dir","{output_dir}","--mode","{mode}"]
# Real-run validation report on this trusted inference host (schema: docs/ENGINE_VALIDATION_GATE.md).
MESH3D_ENGINE_TRIPOSR_VALIDATION_REPORT=/data/validation-reports/triposr-validation.json
MESH3D_TRIPOSR_ROOT=/opt/mesh3d/engines/TripoSR
# MESH3D_TRIPOSR_PYTHON=/opt/mesh3d/engines/TripoSR/.venv/bin/python
MESH3D_TRIPOSR_BAKE_TEXTURE=true

# Multi-view photogrammetry/geometry engines
MESH3D_ENGINE_MESHROOM_CMD=["python","/opt/mesh3d/wrappers/meshroom.py","--input-dir","{input_dir}","--output-dir","{output_dir}","--mode","{mode}"]
# Real-run validation report on this trusted inference host (schema: docs/ENGINE_VALIDATION_GATE.md).
MESH3D_ENGINE_MESHROOM_VALIDATION_REPORT=/data/validation-reports/meshroom-validation.json
MESH3D_MESHROOM_ROOT=/opt/mesh3d/engines/Meshroom
MESH3D_MESHROOM_BATCH=/opt/mesh3d/engines/Meshroom/meshroom_batch
# CPU-only hosts run the photogrammetryDraft pipeline (default); the full pipeline needs CUDA depth maps.
MESH3D_MESHROOM_PIPELINE=photogrammetryDraft

MESH3D_ENGINE_COLMAP_OPENMVS_CMD=["python","/opt/mesh3d/wrappers/colmap_openmvs.py","--input-dir","{input_dir}","--output-dir","{output_dir}","--mode","{mode}"]
# Real-run validation report on this trusted inference host (schema: docs/ENGINE_VALIDATION_GATE.md).
MESH3D_ENGINE_COLMAP_OPENMVS_VALIDATION_REPORT=/data/validation-reports/colmap_openmvs-validation.json
MESH3D_COLMAP_BIN=colmap
MESH3D_OPENMVS_BIN_DIR=/opt/mesh3d/engines/openMVS/bin
