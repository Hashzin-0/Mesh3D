# Copy to .env for local Docker Compose use. Keep real secrets out of Git.
MESH3D_CORS_ORIGINS=http://localhost:5173
MESH3D_DATA_DIR=/data
MESH3D_MAX_IMAGE_BYTES=26214400
MESH3D_MAX_IMAGES=80
MESH3D_JOB_TIMEOUT_SECONDS=3600
MESH3D_ENGINE_TIMEOUT_SECONDS=7200
REDIS_URL=redis://redis:6379/0

# Mount your separately cloned, pinned upstream repositories into ./engines (see docs/ENGINE_INTEGRATION.md).
# Each engine needs its own compatible Python environment; set *_PYTHON to that interpreter.
# Do not download checkpoints into Git. Use /data/model-cache for model/cache files.
HF_HOME=/data/model-cache/huggingface
TORCH_HOME=/data/model-cache/torch

# Single-image engines
MESH3D_ENGINE_TRIPOSR_CMD=["python","/opt/mesh3d/wrappers/triposr.py","--input-dir","{input_dir}","--output-dir","{output_dir}","--mode","{mode}"]
MESH3D_ENGINE_TRIPOSR_LICENSE_APPROVED=false
MESH3D_TRIPOSR_ROOT=/opt/mesh3d/engines/TripoSR
# MESH3D_TRIPOSR_PYTHON=/opt/mesh3d/engines/TripoSR/.venv/bin/python
MESH3D_TRIPOSR_BAKE_TEXTURE=true

MESH3D_ENGINE_INSTANTMESH_CMD=["python","/opt/mesh3d/wrappers/instantmesh.py","--input-dir","{input_dir}","--output-dir","{output_dir}","--mode","{mode}"]
MESH3D_ENGINE_INSTANTMESH_LICENSE_APPROVED=false
MESH3D_INSTANTMESH_ROOT=/opt/mesh3d/engines/InstantMesh
# MESH3D_INSTANTMESH_PYTHON=/opt/mesh3d/engines/InstantMesh/.venv/bin/python
# MESH3D_INSTANTMESH_CONFIG=/opt/mesh3d/engines/InstantMesh/configs/instant-mesh-large.yaml
MESH3D_INSTANTMESH_SAVE_VIDEO=false

MESH3D_ENGINE_STABLE_FAST_3D_CMD=["python","/opt/mesh3d/wrappers/stable_fast_3d.py","--input-dir","{input_dir}","--output-dir","{output_dir}","--mode","{mode}"]
MESH3D_ENGINE_STABLE_FAST_3D_LICENSE_APPROVED=false
MESH3D_ENGINE_STABLE_FAST_3D_LICENSE_APPROVED_EXTRA=false
MESH3D_STABLE_FAST_3D_ROOT=/opt/mesh3d/engines/stable-fast-3d
# MESH3D_STABLE_FAST_3D_PYTHON=/opt/mesh3d/engines/stable-fast-3d/.venv/bin/python
# Set HF_TOKEN only in the private .env if the gated checkpoint was granted to your account.

MESH3D_ENGINE_HUNYUAN3D_CMD=["python","/opt/mesh3d/wrappers/hunyuan3d.py","--input-dir","{input_dir}","--output-dir","{output_dir}","--mode","{mode}"]
MESH3D_ENGINE_HUNYUAN3D_LICENSE_APPROVED=false
MESH3D_ENGINE_HUNYUAN3D_LICENSE_APPROVED_EXTRA=false
MESH3D_HUNYUAN3D_ROOT=/opt/mesh3d/engines/Hunyuan3D-2.1
# MESH3D_HUNYUAN3D_PYTHON=/opt/mesh3d/engines/Hunyuan3D-2.1/.venv/bin/python
MESH3D_HUNYUAN3D_MODEL=tencent/Hunyuan3D-2.1
MESH3D_HUNYUAN3D_SUBFOLDER=hunyuan3d-dit-v2-1
MESH3D_HUNYUAN3D_STEPS=30
MESH3D_HUNYUAN3D_OCTREE_RESOLUTION=256

# Multi-view photogrammetry/geometry engines
MESH3D_ENGINE_MESHROOM_CMD=["python","/opt/mesh3d/wrappers/meshroom.py","--input-dir","{input_dir}","--output-dir","{output_dir}","--mode","{mode}"]
MESH3D_ENGINE_MESHROOM_LICENSE_APPROVED=false
MESH3D_MESHROOM_ROOT=/opt/mesh3d/engines/Meshroom
MESH3D_MESHROOM_BATCH=/opt/mesh3d/engines/Meshroom/meshroom_batch

MESH3D_ENGINE_COLMAP_OPENMVS_CMD=["python","/opt/mesh3d/wrappers/colmap_openmvs.py","--input-dir","{input_dir}","--output-dir","{output_dir}","--mode","{mode}"]
MESH3D_ENGINE_COLMAP_OPENMVS_LICENSE_APPROVED=false
MESH3D_ENGINE_COLMAP_OPENMVS_LICENSE_APPROVED_EXTRA=false
MESH3D_COLMAP_BIN=colmap
MESH3D_OPENMVS_BIN_DIR=/opt/mesh3d/engines/openMVS/bin

MESH3D_ENGINE_VGGT_CMD=["python","/opt/mesh3d/wrappers/vggt.py","--input-dir","{input_dir}","--output-dir","{output_dir}","--mode","{mode}"]
MESH3D_ENGINE_VGGT_LICENSE_APPROVED=false
MESH3D_ENGINE_VGGT_LICENSE_APPROVED_EXTRA=false
MESH3D_VGGT_ROOT=/opt/mesh3d/engines/vggt
# MESH3D_VGGT_PYTHON=/opt/mesh3d/engines/vggt/.venv/bin/python
MESH3D_VGGT_USE_BA=false
